  "folder": "Intervals",
  "className": "NonOverlappingIntervals",
  "statement": "Return the minimum number of intervals you must remove so that the rest do not overlap. Intervals that merely touch at an endpoint do not count as overlapping.",
  "constraints": [
    "1 <= intervals.Length <= 10^5",
    "start < end for every interval"
  ],
  "hints": [
    "Removing the fewest is the same as KEEPING the most, which is the classic activity selection problem.",
    "Sort by END, not by start. Always keeping the interval that finishes earliest leaves the most room for the rest.",
    "Sweep, keeping an interval whenever its start is at or after the last kept end. The answer is the total minus the number kept."
  ],
  "complexity": "O(n log n) time",
  "signature": "int Solve(int[][] intervals)",
  "cases": [
