  "signature": "int Solve(string[] tokens)",
  "statement": "Evaluate an expression in reverse Polish notation, where each operator follows its two operands. Division truncates toward zero.",
  "constraints": [
    "1 <= tokens.Length <= 10^4",
    "operators are + - * /",
    "the expression is always valid"
  ],
  "hints": [
    "Push numbers. On an operator, pop two values, apply, push the result.",
    "Order matters for subtraction and division: the value popped FIRST is the right-hand operand.",
    "C# integer division already truncates toward zero, so a / b needs no adjustment."
  ],
  "complexity": "O(n) time, O(n) space",
  "comparison": "Exact",
  "cases": [
