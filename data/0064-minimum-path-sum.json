    "0 <= grid[i][j] <= 200"
  ],
  "hints": [
    "Greedy choice at each step is wrong; a cheap first move can lead into an expensive region.",
    "best[r][c] = grid[r][c] + min(best[r-1][c], best[r][c-1]).",
    "The top row and left column have only one way in, so fill them as running sums first. You can write the answers into the grid itself."
  ],
  "complexity": "O(rows*cols) time",
  "signature": "int Solve(int[][] grid)",
