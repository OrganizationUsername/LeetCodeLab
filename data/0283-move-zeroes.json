  "slug": "move-zeroes",
  "title": "Move Zeroes",
  "difficulty": "Easy",
  "topics": [
    "Array",
    "Two Pointers"
  ],
  "url": "https://leetcode.com/problems/move-zeroes/",
  "folder": "Arrays",
  "className": "MoveZeroes",
  "signature": "void Solve(int[] nums)",
  "statement": "Move every zero to the end of the array while keeping the non-zero values in their original relative order. Do it in place; the method returns nothing and the array itself is checked.",
  "constraints": [
    "1 <= nums.Length <= 10^4"
  ],
  "hints": [
    "Two cursors: one reading, one marking where the next non-zero should be written.",
    "First pass, copy every non-zero value to the write cursor and advance it.",
    "Second pass, fill everything from the write cursor onward with zeros."
  ],
  "complexity": "O(n) time, O(1) space",
  "comparison": "MutatedArg",
  "cases": [
    {
      "args": [
        [
          0,
          1,
          0,
          3,
          12
        ]
      ],
      "expected": [
        1,
        3,
        12,
        0,
        0
      ]
    },
    {
      "args": [
        [
          0
        ]
      ],
      "expected": [
        0
      ]
    },
    {
      "args": [
        [
          1,
          0,
          1
        ]
      ],
      "expected": [
        1,
        1,
        0
      ]
    },
    {
      "name": "single non-zero",
      "args": [
        [
          1
        ]
      ],
      "expected": [
        1
      ]
    },
    {
      "name": "all zeros",
      "args": [
        [
          0,
          0
        ]
      ],
      "expected": [
        0,
        0
      ]
    },
    {
      "name": "no zeros",
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": [
        1,
        2,
        3
      ]
    },
    {
      "name": "leading zero",
      "args": [
        [
          0,
          1
        ]
      ],
      "expected": [
        1,
        0
      ]
    },
    {
      "name": "zeros between values",
      "args": [
        [
          1,
          0,
          2,
          0,
          3
        ]
      ],
      "expected": [
        1,
        2,
        3,
        0,
        0
      ]
    }
  ]
