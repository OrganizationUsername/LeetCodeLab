  "className": "PathSum",
  "signature": "bool Solve(TreeNode? root, int targetSum)",
  "statement": "Return true when some root-to-LEAF path has values summing to targetSum. A leaf is a node with no children; stopping partway down does not count.",
  "constraints": [
    "0 <= node count <= 5000",
    "values may be negative"
  ],
  "hints": [
    "Carry the remaining target down the recursion, subtracting each node value.",
    "The success test happens at a leaf: no children left AND the remainder is exactly zero.",
    "The empty tree is false. Be careful not to treat a node with one child as a leaf."
  ],
  "complexity": "O(n) time, O(h) space",
