  "className": "LastStoneWeight",
  "statement": "Repeatedly smash the two heaviest stones together. Equal stones destroy each other; otherwise the heavier one survives with the weight difference. Return the weight of the last stone, or 0 if none remain.",
  "constraints": [
    "1 <= stones.Length <= 30",
    "1 <= stones[i] <= 1000"
  ],
  "hints": [
    "You need the two largest values repeatedly, and the set changes after each smash.",
    "That is exactly a max-heap. C# PriorityQueue is a min-heap, so enqueue with a negated priority.",
    "Loop while more than one stone remains, popping two and pushing the difference back when it is non-zero."
  ],
  "complexity": "O(n log n) time",
  "signature": "int Solve(int[] stones)",
  "cases": [
