    "1 <= root node count <= 2000",
    "1 <= subRoot node count <= 1000"
  ],
  "hints": [
    "You already have the tool: an equality check between two trees, which is Same Tree.",
    "At every node of root, ask whether the tree rooted here equals subRoot.",
    "If not, recurse into both children. TreeNodes.Equal in LeetCodeLab.Core does the equality half for you."
  ],
  "complexity": "O(n * m) time",
  "signature": "bool Solve(TreeNode? root, TreeNode? subRoot)",
  "comparison": "Exact",
