      "expected": true
    },
    {
      "name": "single node",
      "args": [
        [
          1
        ]
      ],
      "expected": true
    },
    {
      "name": "one child is still balanced",
      "args": [
        [
          1,
          2
        ]
      ],
      "expected": true
    },
    {
      "name": "a chain of three is not",
      "args": [
        [
          1,
          2,
          null,
          3
        ]
      ],
      "expected": false
    },
    {
      "name": "the standard balanced example",
      "args": [
