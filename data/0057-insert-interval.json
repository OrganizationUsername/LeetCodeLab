  "className": "InsertInterval",
  "signature": "int[][] Solve(int[][] intervals, int[] newInterval)",
  "statement": "The intervals are already sorted by start and do not overlap. Insert newInterval, merging where necessary, and return the result still sorted and non-overlapping.",
  "constraints": [
    "0 <= intervals.Length <= 10^4",
    "intervals are sorted by start and disjoint"
  ],
  "hints": [
    "The input is already sorted, so no sort is needed and the whole thing is O(n).",
    "Three phases: copy everything ending strictly before the new interval starts, then absorb everything that overlaps, then copy the rest.",
    "While absorbing, widen the new interval to the min of the starts and the max of the ends. Emit it once the overlapping run is done."
  ],
  "complexity": "O(n) time",
