  "folder": "SlidingWindow",
  "className": "MaximumAverageSubarray",
  "statement": "Return the maximum average value over any contiguous slice of exactly length k. Answers are compared to within 1e-5.",
  "constraints": [
    "1 <= k <= nums.Length <= 10^5",
    "-10^4 <= nums[i] <= 10^4"
  ],
  "hints": [
    "The window length is fixed, so maximising the average is the same as maximising the sum.",
    "Sum the first k values, then slide: add the entering value and subtract the leaving one.",
    "Divide once at the end, and divide by a double so you do not truncate."
  ],
  "complexity": "O(n) time, O(1) space",
  "signature": "double Solve(int[] nums, int k)",
  "cases": [
    {
      "args": [
        [
          1,
          12,
          -5,
          -6,
          50,
          3
        ],
        4
      ],
      "expected": 12.75
    },
    {
      "args": [
        [
          5
        ],
        1
      ],
      "expected": 5.0
    },
    {
      "args": [
        [
          0,
          4,
          0,
          3,
          2
        ],
        1
      ],
      "expected": 4.0
