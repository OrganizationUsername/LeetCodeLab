{
  "id": 98,
  "slug": "validate-binary-search-tree",
  "title": "Validate Binary Search Tree",
  "difficulty": "Medium",
  "topics": [
    "Tree",
    "DFS",
    "BST",
    "Binary Tree"
  ],
  "url": "https://leetcode.com/problems/validate-binary-search-tree/",
  "folder": "Trees",
  "className": "ValidateBinarySearchTree",
  "statement": "Return true if the tree is a valid binary search tree: every value in a left subtree is strictly less than its node, every value in a right subtree strictly greater, and both subtrees are themselves valid.",
  "constraints": [
    "0 <= node count <= 10^4",
    "node values fit in a 32-bit integer"
  ],
  "hints": [
    "Checking only node against its two children is wrong. A deep descendant can still violate the ordering.",
    "Carry a permitted open interval down the recursion. The root may be anything; going left tightens the upper bound to the node value, going right tightens the lower bound.",
    "Use long bounds, or nullable ints, so that a node holding int.MinValue does not produce a false negative."
  ],
  "complexity": "O(n) time, O(h) space",
  "signature": "bool Solve(TreeNode? root)",
  "comparison": "Exact",
  "cases": [
    {
      "args": [
        [
          2,
          1,
          3
        ]
      ],
      "expected": true
    },
    {
      "args": [
        [
          5,
          1,
          4,
          null,
          null,
          3,
          6
        ]
      ],
      "expected": false
    },
    {
      "args": [
        [
          5,
          4,
          6,
          null,
          null,
          3,
          7
        ]
      ],
      "expected": false
    },
    {
      "name": "empty tree",
      "args": [
        null
      ],
      "expected": true
    },
    {
      "name": "single node",
      "args": [
        [
          1
        ]
      ],
      "expected": true
    },
    {
      "name": "equal value on the left is not strictly less",
      "args": [
        [
          1,
          1
        ]
      ],
      "expected": false
    },
    {
      "name": "classic invalid",
      "args": [
        [
          5,
          1,
          4,
          null,
          null,
          3,
          6
        ]
      ],
      "expected": false
    },
    {
      "name": "violation deep in the right subtree, not against its parent",
      "args": [
        [
          10,
          5,
          15,
          null,
          null,
          6,
          20
        ]
      ],
      "expected": false
    },
    {
      "name": "simple valid",
      "args": [
        [
          2,
          1,
          3
        ]
      ],
      "expected": true
    },
    {
      "name": "full valid tree",
      "args": [
        [
          3,
          1,
          5,
          0,
          2,
          4,
          6
        ]
      ],
      "expected": true
    }
  ]
}
