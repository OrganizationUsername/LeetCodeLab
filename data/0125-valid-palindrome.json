{
  "id": 125,
  "slug": "valid-palindrome",
  "title": "Valid Palindrome",
  "difficulty": "Easy",
  "topics": [
    "Two Pointers",
    "String"
  ],
  "url": "https://leetcode.com/problems/valid-palindrome/",
  "folder": "TwoPointers",
  "className": "ValidPalindrome",
  "signature": "bool Solve(string s)",
  "statement": "Return true when the string reads the same forwards and backwards, considering only letters and digits and ignoring case. Everything else is skipped.",
  "constraints": [
    "1 <= s.Length <= 2*10^5",
    "printable ASCII"
  ],
  "hints": [
    "Two pointers, one from each end, walking toward each other.",
    "Advance each pointer past anything that is not a letter or digit before comparing.",
    "Compare case-insensitively. char.IsLetterOrDigit and char.ToLowerInvariant do the work."
  ],
  "complexity": "O(n) time, O(1) space",
  "comparison": "Exact",
  "cases": [
    {
      "args": [
        "A man, a plan, a canal: Panama"
      ],
      "expected": true
    },
    {
      "args": [
        "race a car"
      ],
      "expected": false
    },
    {
      "args": [
        " "
      ],
      "expected": true
    },
    {
      "name": "empty string",
      "args": [
        ""
      ],
      "expected": true
    },
    {
      "name": "single letter",
      "args": [
        "a"
      ],
      "expected": true
    },
    {
      "name": "two different letters",
      "args": [
        "ab"
      ],
      "expected": false
    },
    {
      "name": "two identical letters",
      "args": [
        "aa"
      ],
      "expected": true
    },
    {
      "name": "digit against letter",
      "args": [
        "0P"
      ],
      "expected": false
    },
    {
      "name": "punctuation ignored",
      "args": [
        "a."
      ],
      "expected": true
    },
    {
      "name": "apostrophes and commas",
      "args": [
        "Madam, I'm Adam"
      ],
      "expected": true
    },
    {
      "name": "nothing alphanumeric",
      "args": [
        ".,"
      ],
      "expected": true
    }
  ]
}
