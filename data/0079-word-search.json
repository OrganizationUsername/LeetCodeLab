  "url": "https://leetcode.com/problems/word-search/",
  "folder": "Backtracking",
  "className": "WordSearch",
  "statement": "Return true if word can be spelled by walking the grid from cell to cell through shared edges, without reusing a cell within that path. Cells may be reused across different starting attempts.",
  "constraints": [
    "1 <= rows, cols <= 6",
    "1 <= word.Length <= 15"
  ],
  "hints": [
    "Try to start the walk from every cell, and depth-first search from each.",
    "At each step the current cell must match the current letter; otherwise this path fails immediately.",
    "Mark the cell as visited before recursing and restore it afterwards. Overwriting with a sentinel character avoids a second visited array."
  ],
  "complexity": "O(rows * cols * 4^len) worst case",
  "signature": "bool Solve(char[][] board, string word)",
  "comparison": "Exact",
